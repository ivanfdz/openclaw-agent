# Copia este fichero a secrets.env y rellena los valores. secrets.env está gitignored.
#
# Estas variables terminan en repo/.env, que es el env_file que lee Docker Compose.
# El flag --secret-input-mode ref del onboarding hace que la clave se quede como
# referencia a la variable de entorno en vez de copiarse dentro de openclaw.json.

# --- Proveedor LLM ---
# Rellena SOLO la que corresponda a OPENCLAW_AUTH_CHOICE en config.env.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Telegram ---
# Token que te da @BotFather al crear el bot (/newbot).
TELEGRAM_BOT_TOKEN=

# --- Tu identidad en Telegram ---
# Tu user ID numérico (NO el username, NO un chat de grupo).
# Déjalo vacío de momento: `make telegram-pairing` arranca en modo pairing,
# le escribes al bot, y su respuesta te dice tu user id. Luego `make lockdown ID=...`.
TELEGRAM_OWNER_ID=
