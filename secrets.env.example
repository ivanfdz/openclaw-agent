# Copy this file to secrets.env and fill in the values. secrets.env is gitignored.
#
# These variables end up in repo/.env, which is the env_file Docker Compose reads.
# The onboarding flag --secret-input-mode ref makes the key stay as a reference to
# the environment variable instead of being copied into openclaw.json.

# --- LLM provider ---
# Fill in ONLY the one matching OPENCLAW_AUTH_CHOICE in config.env.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Telegram ---
# The token @BotFather gives you when you create the bot (/newbot).
TELEGRAM_BOT_TOKEN=

# --- Your Telegram identity ---
# Your numeric user ID (NOT the username, NOT a group chat).
# Leave it empty for now: `make telegram-pairing` starts in pairing mode, you
# message the bot, and its reply tells you your user id. Then `make lockdown ID=...`.
TELEGRAM_OWNER_ID=
