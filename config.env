# Non-sensitive configuration for the OpenClaw gateway in Docker.
# Secrets go in secrets.env (gitignored). Paths are injected by the Makefile.

# Official prebuilt image. The -browser variant ships Chromium + Xvfb already installed,
# which is needed for web automation without paying a `playwright install` on first start.
# Building from source would ask 6 GB of RAM from the builder; not necessary.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest-browser

# Timezone for the gateway and the CLI (the image defaults to UTC).
OPENCLAW_TZ=Europe/Madrid

# Control UI port. docker-compose.hardening.yml publishes it on 127.0.0.1 only.
OPENCLAW_GATEWAY_PORT=18789

# Bind address INSIDE the container. It has to be `lan` for Docker's port
# publishing to work; the real isolation comes from the hardening file (loopback
# on the host).
OPENCLAW_GATEWAY_BIND=lan

# Named volume for /home/node: persists Chromium caches and binaries installed
# inside the container across image updates.
OPENCLAW_HOME_VOLUME=openclaw_home

# Bonjour/mDNS does not cross Docker's bridge reliably. Explicitly off.
OPENCLAW_DISABLE_BONJOUR=1

# setup.sh's interactive onboarding is skipped: we do it headless from the Makefile.
OPENCLAW_SKIP_ONBOARDING=1

# LLM provider. Valid --auth-choice ids:
#   apiKey          -> Anthropic API key   (needs ANTHROPIC_API_KEY)
#   openai-api-key  -> OpenAI API key      (needs OPENAI_API_KEY)
#   gemini-api-key  -> Google AI Studio    (needs GEMINI_API_KEY)
#
# If you switch provider: update secrets.env, remove the old provider's key from
# repo/.env (sync-secrets only adds and updates, it never deletes) and re-run
# `make onboard`. Leaving two valid keys in place makes autodetection ambiguous.
OPENCLAW_AUTH_CHOICE=gemini-api-key

# Default model. It gets applied with `make cli CMD='models set <ref>'`, not through
# this variable; it's documented here because it's the least obvious decision in the
# whole setup.
#
# Picking a model on Gemini has four traps, all verified against the API:
#
# 1. The one onboarding picks (gemini-3.1-pro-preview) returns 429
#    RESOURCE_EXHAUSTED with a free-tier key. It isn't in the tier.
# 2. `models list` mixes the plugin catalog with what Google advertises live. A
#    model that's listed but outside the catalog (e.g. gemini-3.8-flash) fails
#    with "Unknown model" when called, even though `models set` accepts it.
# 3. gemini-2.5-flash and 2.5-flash-lite return a permanent 404: "no longer
#    available to new users". Google recommends gemini-3.6-flash instead.
#    Don't put them in the fallback chain, they will never respond.
# 4. gemini-3.6-flash and 3.7-flash return 503 UNAVAILABLE ("high demand")
#    intermittently. It's transient, but as your primary it leaves you stranded.
#
# gemini-3.5-flash is the one responding reliably right now.
OPENCLAW_MODEL_PRIMARY=google/gemini-3.5-flash

# KNOWN LIMITATION of the current fallback chain: all three models are Gemini, so
# they cover a 503 on one specific model but NOT a 429 quota error, which is
# project-wide and takes all three down at once. If that bothers you, the fix is a
# fallback from ANOTHER provider: add its key to secrets.env and run
# `make cli CMD='models fallbacks add <provider>/<model>'`.

# Diagnostic trick: to find out whether a failure is the model, the quota or
# OpenClaw, hit the API raw. Use the v1 endpoint, NOT v1beta: in testing v1beta
# returned 404 with an empty body while v1 gave the real error JSON.
#   curl -sS -X POST \
#     "https://generativelanguage.googleapis.com/v1/models/<model>:generateContent" \
#     -H "x-goog-api-key: $GEMINI_API_KEY" -H 'Content-Type: application/json' \
#     -d '{"contents":[{"parts":[{"text":"hello"}]}]}'
# And send requests one at a time: in bursts it returns empty bodies.
